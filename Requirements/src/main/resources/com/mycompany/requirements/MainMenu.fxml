<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="166.0" prefWidth="283.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.requirements.MainMenuController">
    <children>
        <VBox alignment="CENTER" layoutX="37.0" prefHeight="122.0" prefWidth="209.0">
            <children>
                <Label alignment="TOP_LEFT" contentDisplay="CENTER" text="Menu" textAlignment="CENTER">
                    <font>
                        <Font size="31.0" />
                    </font>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </Label>
                <Label fx:id="loggedInUsernameLabel" text="Logged in as: " wrapText="true">  
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>
                <Button fx:id="userManagementButton" mnemonicParsing="false" onAction="#onUserMgmtClicked" text="User Management">
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="fileManagementButton" layoutX="10.0" layoutY="54.0" mnemonicParsing="false" onAction="#onFileManagementClicked" text="File Management">
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="logoutButton" layoutX="10.0" layoutY="80.0" mnemonicParsing="false" onAction="#onLogoutClicked" text="Log out" />
            </children>
        </VBox>
    </children>
</AnchorPane>
